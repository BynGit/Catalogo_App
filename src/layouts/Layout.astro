---
interface Props {
	title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
	<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
	</head>
	<body class="bg-gray-50 text-gray-800 font-sans min-h-screen flex items-center justify-center p-4">
		<div class="bg-white w-full max-w-7xl h-[90vh] rounded-3xl shadow-lg border border-gray-100 flex overflow-hidden">
			<slot />
		</div>
	</body>
</html>