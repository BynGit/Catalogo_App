---
interface Props {
  idProducto: number;
  nombre: string;
  imagen: string;
  categoria: string;
  precio: string;
}

const { idProducto, nombre, imagen, categoria, precio } = Astro.props;
---

<div
  class="flex flex-col rounded-2xl border border-gray-100 overflow-hidden hover:shadow-lg transition-shadow bg-white"
  data-producto-category={categoria}
  data-product-name={nombre}
>
  <div class={`h-40 w-full flex items-center justify-center p-4`}>
    <div
      class="w-24 h-24 bg-black/10 rounded-lg shadow-sm flex items-center justify-center text-gray-500 text-xs"
    >
      <img
        src={imagen}
        alt={`${nombre} - ${idProducto}  `}
        class="w-full h-full object-contain"
      />
    </div>
  </div>

  <div class="p-4 flex flex-col gap-3">
    <div>
      <h3 class="text-sm font-medium text-gray-700 mb-2 line-clamp-1">
        {nombre}
      </h3>
      <div class="mb-2">
        <span
          class="inline-block px-2 py-1 bg-blue-100 text-blue-700 text-xs font-semibold rounded-full"
        >
          {categoria}
        </span>
      </div>
      <p class="text-lg font-bold text-gray-900">
        {
          new Intl.NumberFormat("es-CO", {
            style: "currency",
            currency: "COP",
            minimumFractionDigits: 0,
          }).format(parseInt(precio))
        }
      </p>
    </div>
    <button
      class="add-to-cart-btn w-full bg-purple-600 hover:bg-purple-700 text-white font-semibold py-2 rounded-lg transition-colors duration-200 flex items-center justify-center gap-2"
      data-product-id={idProducto}
      data-product-name={nombre}
      data-product-image={imagen}
      data-product-categoria={categoria}
      data-product-precio={precio}
    >
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
        <path
          d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"
        ></path>
      </svg>
      Añadir al Carrito
    </button>
  </div>
</div>
