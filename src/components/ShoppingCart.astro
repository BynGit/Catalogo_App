---

---

<div id="shopping-cart-container" class="fixed bottom-8 right-8 z-50">
  <!-- Botón flotante del carrito -->
  <button
    id="cart-toggle-btn"
    class="relative w-14 h-14 rounded-full bg-purple-600 hover:bg-purple-700 text-white shadow-lg flex items-center justify-center transition-all hover:scale-110 duration-200"
    aria-label="Abrir carrito de compras"
  >
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"
      ></path>
    </svg>
    <span
      id="cart-count"
      class="absolute top-0 right-0 bg-red-500 text-white text-xs font-bold rounded-full w-5 h-5 flex items-center justify-center"
    >
      0
    </span>
  </button>

  <!-- Panel del carrito (oculto por defecto) -->
  <div
    id="cart-panel"
    class="hidden absolute bottom-20 right-0 w-96 bg-white rounded-2xl shadow-2xl border border-gray-200 max-h-96 flex flex-col"
  >
    <!-- Header -->
    <div
      class="bg-purple-600 text-white p-4 rounded-t-2xl flex justify-between items-center"
    >
      <h3 class="text-lg font-bold">Carrito de Compras</h3>
      <button
        id="cart-close-btn"
        class="text-white hover:bg-purple-700 p-1 rounded transition"
        aria-label="Cerrar carrito"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path
            fill-rule="evenodd"
            d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
            clip-rule="evenodd"></path>
        </svg>
      </button>
    </div>

    <!-- Lista de productos -->
    <div id="cart-items" class="flex-1 overflow-y-auto p-4 space-y-3">
      <!-- Los productos se insertan aquí -->
    </div>

    <!-- Mensaje vacío -->
    <div
      id="cart-empty-message"
      class="hidden flex flex-col items-center justify-center py-8 text-gray-500"
    >
      <svg
        class="w-12 h-12 mb-2 text-gray-300"
        fill="currentColor"
        viewBox="0 0 20 20"
      >
        <path
          d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"
        ></path>
      </svg>
      <p class="text-sm font-medium">Carrito vacío</p>
    </div>

    <!-- Total y botón -->
    <div class="border-t border-gray-200 p-4 space-y-3">
      <div class="flex justify-between items-center font-bold text-lg">
        <span>Total:</span>
        <span id="cart-total" class="text-purple-600">$0</span>
      </div>
      <button
        id="checkout-btn"
        class="w-full bg-purple-600 hover:bg-purple-700 text-white font-bold py-2 rounded-lg transition disabled:opacity-50 disabled:cursor-not-allowed"
        disabled
      >
        Ir a Pagar
      </button>
    </div>
  </div>
</div>

<script>
  interface CartItem {
    idProducto: string;
    nombre: string;
    imagen: string;
    categoria: string;
    precio: string;
    quantity: number;
  }

  declare global {
  interface Window {
    addToCart: (idProducto: number) => void; 
  }
}

  const STORAGE_KEY = "shopping_cart";

  const cartToggleBtn = document.getElementById("cart-toggle-btn")!;
  const cartCloseBtn = document.getElementById("cart-close-btn")!;
  const cartPanel = document.getElementById("cart-panel")!;
  const cartItemsContainer = document.getElementById("cart-items")!;
  const cartCountSpan = document.getElementById("cart-count")!;
  const cartTotalSpan = document.getElementById("cart-total")!;
  const cartEmptyMessage = document.getElementById("cart-empty-message")!;
  const checkoutBtn = document.getElementById("checkout-btn")! as HTMLButtonElement;

  // Cargar carrito desde localStorage
  function loadCart(): CartItem[] {
    const cartData = localStorage.getItem(STORAGE_KEY);
    return cartData ? JSON.parse(cartData) : [];
  }

  // Guardar carrito en localStorage
  function saveCart(cart: CartItem[]): void {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(cart));
  }

  // Renderizar carrito
  function renderCart(): void {
    const cart = loadCart();

    // Actualizar contador
    const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
    cartCountSpan.textContent = totalItems.toString();

    // Limpiar contenedor
    cartItemsContainer.innerHTML = "";

    if (cart.length === 0) {
      cartEmptyMessage.classList.remove("hidden");
      cartItemsContainer.classList.add("hidden");
      checkoutBtn.disabled = true;
      cartTotalSpan.textContent = "$0";
      return;
    }

    cartEmptyMessage.classList.add("hidden");
    cartItemsContainer.classList.remove("hidden");
    checkoutBtn.disabled = false;

    let total = 0;

    cart.forEach((item, index) => {
      const itemPrice = parseInt(item.precio) * item.quantity;
      total += itemPrice;

      const itemElement = document.createElement("div");
      itemElement.className =
        "flex gap-3 p-3 bg-gray-50 rounded-lg border border-gray-200 hover:border-purple-300 transition";
      itemElement.innerHTML = `
        <img
          src="${item.imagen}"
          alt="${item.nombre}"
          class="w-16 h-16 object-contain rounded"
        />
        <div class="flex-1 min-w-0">
          <h4 class="font-semibold text-sm text-gray-800 truncate">${item.nombre}</h4>
          <p class="text-xs text-gray-500 mb-2">${item.categoria}</p>
          <div class="flex items-center justify-between">
            <span class="font-bold text-sm text-purple-600">
              $${parseInt(item.precio).toLocaleString("es-CO")}
            </span>
          </div>
        </div>
        <button
          class="remove-item text-red-500 hover:text-red-700 font-bold"
          data-index="${index}"
          aria-label="Eliminar"
        >
          ✕
        </button>
      `;
      cartItemsContainer.appendChild(itemElement);
    });

    // Actualizar total
    cartTotalSpan.textContent = `$${total.toLocaleString("es-CO")}`;

    // Event listeners para botones
    document.querySelectorAll(".remove-item").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const index = parseInt(
          (e.target as HTMLElement).getAttribute("data-index")!,
        );
        removeFromCart(index);
      });
    });

    // Actualizar estado de los botones de añadir en los productos
    updateAddToCartButtons();
  }

  // Función para verificar si un producto está en el carrito
  function isProductInCart(productId: string): boolean {
    const cart = loadCart();
    return cart.some((item) => item.idProducto === productId);
  }

  // Actualizar estado de todos los botones de añadir
  function updateAddToCartButtons(): void {
    const cart = loadCart();
    const isCartEmpty = cart.length === 0;

    document.querySelectorAll(".add-to-cart-btn").forEach((btn: any) => {
      // Si el carrito está vacío, habilitar todos los botones
      if (isCartEmpty) {
        btn.disabled = false;
        btn.innerHTML =
          '<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg> Añadir al Carrito';
        btn.classList.remove("opacity-50", "cursor-not-allowed");
        return;
      }

      // Si hay productos en el carrito, verificar si este producto está
      const productId = btn.getAttribute("data-product-id");
      if (isProductInCart(productId)) {
        btn.disabled = true;
        btn.textContent = "✓ En el carrito";
        btn.classList.add("opacity-50", "cursor-not-allowed");
      } else {
        btn.disabled = false;
        btn.innerHTML =
          '<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg> Añadir al Carrito';
        btn.classList.remove("opacity-50", "cursor-not-allowed");
      }
    });
  }

  // Agregar producto al carrito (solo si no existe)
  window.addToCart = (product: any) => {
    const cart = loadCart();
    const existingItem = cart.findIndex(
      (item) => item.idProducto === product.idProducto,
    );

    // No permitir duplicados
    if (existingItem >= 0) {
      console.warn("Producto ya está en el carrito");
      return false;
    }

    cart.push({ ...product, quantity: 1 });
    saveCart(cart);
    renderCart();
    return true;
  };

  // Eliminar producto del carrito
  function removeFromCart(index: number): void {
    const cart = loadCart();
    cart.splice(index, 1);
    saveCart(cart);

    // Si el carrito queda vacío, recargar la página
    if (cart.length === 0) {
      window.location.reload();
    } else {
      renderCart();
    }
  }
  cartToggleBtn.addEventListener("click", () => {
    cartPanel.classList.toggle("hidden");
  });

  cartCloseBtn.addEventListener("click", () => {
    cartPanel.classList.add("hidden");
  });

  // Cerrar al hacer click fuera
  document.addEventListener("click", (e) => {
    const target = e.target as Node;
    const container = document.getElementById("shopping-cart-container")!;
    if (!container.contains(target)) {
      cartPanel.classList.add("hidden");
    }
  });

  // Renderizar carrito al cargar
  renderCart();
</script>
